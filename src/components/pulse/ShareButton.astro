---
// WhatsApp share button — composes branded text from verdict sentence + receipt count + category URL.
interface Props {
  verdictText: string;
  receiptCount: number;
  categoryUrl: string;
  label?: string;
}

const { verdictText, receiptCount, categoryUrl, label = 'Share this result on WhatsApp' } = Astro.props;
const msg = `${verdictText}\nBased on ${receiptCount} till-verified receipts\n\nSee more: ${categoryUrl}`;
const waUrl = `https://wa.me/?text=${encodeURIComponent(msg)}`;
---

<button
  type="button"
  class="w-full bg-primary-container hover:opacity-90 text-white font-headline text-base font-bold py-3 px-4 rounded-xl flex items-center justify-center gap-2 transition-colors"
  onclick={`window.open('${waUrl}','_blank');if(window.umami)window.umami.track('share_tap')`}
>
  <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">forum</span>
  {label}
</button>