---
// /pulse — category picker with search filter, popular grid, and trust strip.
// Build-time API calls; a failure here fails the build loudly.
import Pulse from '../../layouts/Pulse.astro';
import PulseTopBar from '../../components/pulse/PulseTopBar.astro';
import PulseFooter from '../../components/pulse/PulseFooter.astro';
import { fetchCategories, fetchPublicMetrics, formatPula, type CategoryListItem, type PublicMetrics } from '../../lib/pulse';

let categories: CategoryListItem[];
let metrics: PublicMetrics;
try {
  categories = await fetchCategories();
  metrics = await fetchPublicMetrics();
} catch (e) {
  throw new Error(`Market Pulse home build failed — API unreachable: ${e}`);
}

// Top ~12 by receipt_count for the popular grid.
const popular = [...categories].sort((a, b) => b.receipt_count - a.receipt_count).slice(0, 12);
const categoryCount = categories.length;
const receipts = metrics.verified_receipts.toLocaleString();
---

<Pulse title="Market Pulse — BasketIQ" description="Live prices from till-verified receipts across Botswana. Free. No sign-up.">
  <PulseTopBar />

  <main class="flex-1 flex flex-col px-6 py-8 max-w-md mx-auto w-full gap-8">
    <!-- Hero -->
    <section class="flex flex-col gap-2">
      <h2 class="text-3xl font-headline font-bold text-on-surface leading-tight">What are Botswana shoppers really paying?</h2>
      <p class="text-sm text-on-surface-variant">Live prices from till-verified receipts. Free. No sign-up.</p>
    </section>

    <!-- Search filter -->
    <section class="relative" id="search-section">
      <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-xl">search</span>
      <input
        id="category-search"
        type="text"
        class="w-full pl-10 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-full text-sm text-on-surface placeholder:text-outline focus:outline-none focus:ring-1 focus:ring-primary transition-colors"
        placeholder="Search categories…"
        autocomplete="off"
      />
      <p id="search-empty" class="hidden text-center text-sm text-on-surface-variant mt-4">No categories match your search.</p>
    </section>

    <!-- Popular grid -->
    <section class="flex flex-col gap-4">
      <h3 class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Popular right now</h3>
      <div class="grid grid-cols-2 gap-4" id="popular-grid">
        {popular.map((cat) => (
          <a
            href={`/pulse/${cat.slug}`}
            class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4 flex flex-col gap-1 text-left hover:bg-surface-container-low transition-colors group"
          >
            <div class="flex justify-between items-start w-full">
              <span class="font-headline text-base font-semibold text-on-surface group-hover:text-primary transition-colors leading-snug">{cat.display_label}</span>
              <span class="material-symbols-outlined text-primary text-sm transition-transform group-hover:translate-x-1">chevron_right</span>
            </div>
            <span class="text-sm text-on-surface-variant">{formatPula(cat.median_price)} typical</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Trust strip -->
    <section class="bg-surface-container-lowest border border-outline-variant rounded-xl flex items-center justify-between p-4 text-center divide-x divide-outline-variant shadow-sm">
      <div class="flex flex-col flex-1 px-2">
        <span class="font-headline text-lg text-on-surface font-bold">{receipts}</span>
        <span class="text-xs text-on-surface-variant">verified receipts</span>
      </div>
      <div class="flex flex-col flex-1 px-2">
        <span class="font-headline text-lg text-on-surface font-bold">{categoryCount}</span>
        <span class="text-xs text-on-surface-variant">categories tracked</span>
      </div>
      <div class="flex flex-col flex-1 px-2 justify-center">
        <span class="font-headline text-sm text-on-surface font-bold leading-tight">Updated<br/>daily</span>
      </div>
    </section>

    <!-- B2B teaser -->
    <a
      href="/pulse/{categories[0]?.slug ?? ''}"
      class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4 flex items-center justify-between group hover:bg-surface-container-low transition-colors"
    >
      <span class="text-sm text-on-surface-variant pr-4">Sell FMCG products? Check how your price compares — free.</span>
      <span class="material-symbols-outlined text-primary group-hover:translate-x-1 transition-transform">arrow_forward</span>
    </a>
  </main>

  <PulseFooter />
</Pulse>

<script>
  // Client-side search filter over the full baked list.
  const searchInput = document.getElementById('category-search') as HTMLInputElement | null;
  const grid = document.getElementById('popular-grid');
  const emptyMsg = document.getElementById('search-empty');
  if (searchInput && grid && emptyMsg) {
    const cards = grid.querySelectorAll('a');
    searchInput.addEventListener('input', () => {
      const q = searchInput.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const label = (card.querySelector('span')?.textContent ?? '').toLowerCase();
        const match = label.includes(q);
        (card as HTMLElement).style.display = q === '' || match ? '' : 'none';
        if (match) visible++;
      });
      emptyMsg.classList.toggle('hidden', visible > 0 || q === '');
    });
  }
</script>